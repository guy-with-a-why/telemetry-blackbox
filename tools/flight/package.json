{
  "name": "flight",
  "private": true,
  "description": "Draws the flight-progress strips and the flight log from the repo's issues",
  "type": "module",
  "scripts": {
    "build": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "format": "prettier --write src test",
    "lint": "prettier --check src test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@octokit/rest": "22.0.1",
    "react": "19.3.1",
    "satori": "0.63.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": {
    "printWidth": 120
  }
}
