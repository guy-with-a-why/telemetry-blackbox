{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "telemetry-blackbox",
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='gateway' || @.name.value==='pipeline')].version" },
        { "type": "toml", "path": "firmware/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "firmware/Cargo.lock", "jsonpath": "$.package[?(@.name.value==='firmware')].version" },
        { "type": "toml", "path": "tools/bbcheck/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "tools/bbcheck/uv.lock", "jsonpath": "$.package[?(@.name.value==='bbcheck')].version" }
      ]
    }
  }
}
